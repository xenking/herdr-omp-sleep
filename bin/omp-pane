#!/bin/bash
# Whole body is one compound command: bash must read the file to the closing
# brace before it runs anything. Without this, editing this script while a pane
# is parked makes bash resume at a stale byte offset when the pager exits and
# execute the middle of a line as a command — the pane then falls to the shell
# instead of waking omp. (Seen 2026-08-05.)
{
# omp for a herdr pane, with a sleep state.
#
# Runs omp. When omp exits — whether you quit it or the idle reaper sent it a
# SIGTERM — the pane does NOT die: it parks in a frozen, scrollable view of the
# whole conversation. ENTER wakes omp back into the same session.
#
# Measured: less 1.8 MB + this wrapper 2.2 MB, against ~400 MB for a live omp.
# To actually get rid of the pane, close it in herdr as usual.
set -uo pipefail

agent_dir=${PI_CODING_AGENT_DIR:-$HOME/.omp/agent}
hint_dir="$agent_dir/frozen"
pane_id=${HERDR_PANE_ID:-nopane}
hint="$hint_dir/$pane_id.session"
cursor="$hint_dir/$pane_id.cursor.json"
# The baked frame remains the per-pane parked marker. The cursor is the
# authoritative branch checkpoint; it survives the pager and herdr revival.
frame="$hint_dir/$pane_id.ans"
mkdir -p "$hint_dir"

# Keep the pane in herdr's agents sidebar while it sleeps, but dimmed.
#
# herdr identifies an agent by the pane's foreground process name, so a pane
# parked in a pager would drop off the list. Worse, while the exited omp
# session still owns the pane, herdr skips detection entirely and the row keeps
# showing a live green `omp`. `pane.report_agent` is the supported way to fix
# both: it is the same socket call omp's own herdr integration uses.
#
# The sequence number is the whole trick. herdr keeps the last seq per
# (pane, source) and silently DROPS anything not greater, while still answering
# `ok` - so an undersized seq looks exactly like a working call that does
# nothing. omp's integration seeds its counter with `Date.now() * 1000`, i.e.
# microseconds since the epoch, so `date +%s` is six orders of magnitude too
# small. One second ahead in microseconds beats everything the dead session
# emitted, and stays behind whatever the next omp process seeds on wake.
badge_label="omp (sleeping)"

seq_bump=0

herdr_req() {
	# The socket path is in every pane's env; fall back to the default so the
	# reaper — which runs from launchd with no pane around it — can reuse this.
	local sock=${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}
	[ -S "$sock" ] && [ -n "${HERDR_PANE_ID:-}" ] || return 0
	# Strictly increasing within this process: park and wake can land in the
	# same second (the pager failing to open takes microseconds), and two
	# calls sharing a second would make the second one a silent no-op.
	seq_bump=$((seq_bump + 1))
	printf '{"id":"omp-pane","method":"pane.%s","params":{"pane_id":"%s","seq":%s%s}}\n' \
		"$1" "$HERDR_PANE_ID" "$(( ($(date +%s) + seq_bump) * 1000000 ))" "$2" |
		nc -U "$sock" >/dev/null 2>&1 || true
}

# Take the pane over from the session that just exited, then claim it as a
# dim `unknown` agent: green idle is reserved for a session that can answer.
badge_sleeping() {
	herdr_req clear_agent_authority ',"source":"herdr:omp"'
	herdr_req report_agent ",\"source\":\"omp-pane\",\"agent\":\"$badge_label\",\"state\":\"unknown\""
}

# Hand the pane back as a live row before omp starts.
#
# This used to be `release_agent`, on the theory that omp's own integration
# would own the row again the moment it started. It does — but only on its next
# state CHANGE, because every painter of that row is edge-triggered: herdr's
# process detection re-reports when the pane's foreground process GROUP changes,
# which under a wrapper it never does. So releasing left the pane with no row at
# all, and a pane that woke straight into a long turn stayed missing from the
# agents sidebar for as long as that turn ran — 10+ minutes on wD:p1D
# (2026-08-17), while the work was visibly happening on screen.
#
# Reporting a live `omp` instead is never wrong for longer than one omp event:
# omp's integration outranks this source and takes the row over, session path
# and all, as soon as it says anything.
badge_awake() {
	herdr_req report_agent ",\"source\":\"omp-pane\",\"agent\":\"omp\",\"state\":\"idle\""
	# Drop the parked row's `<age> · <title>` display name. It is display-only
	# metadata the reaper attaches so 50+ sleeping panes are tellable apart, and
	# it outlives the badge it belongs to: left in place, a woken pane keeps
	# advertising how long it slept instead of saying `omp`.
	[ -z "${HERDR_PANE_ID:-}" ] ||
		herdr pane report-metadata "$HERDR_PANE_ID" --source omp-pane \
			--clear-display-agent >/dev/null 2>&1 || true
}

# Label a pane from outside it: `--badge` for parked, `--awake` for live.
#
# bash freezes a script's body at exec, so a wrapper that has been running
# since before either label existed can never grow it — and a long-lived wrapper
# never re-execs either. A pane parked by such a wrapper sleeps correctly but
# herdr keeps showing the dead session's green `omp`; a pane woken by one has no
# row at all, because that body still calls `release_agent`. The reaper repairs
# both from here, which keeps the sequence rule above in a single place.
if [ "${1:-}" = --badge ] || [ "${1:-}" = --awake ]; then
	only=$1
	HERDR_PANE_ID=${2:-${HERDR_PANE_ID:-}}
	if [ "$only" = --badge ]; then badge_sleeping; else badge_awake; fi
	exit 0
fi

# The cursor is the only safe source for a parked branch. A plain `.session`
# file remains the legacy park-vs-exit signal, but its path is not a branch
# identity and an argv `--resume` may be stale after a fork.
clear_live_record() {
	local pid=${1:-} file actual
	case "$pid" in ''|*[!0-9]*) return 0 ;; esac
	file="$hint_dir/$pane_id.live.$pid.json"
	[ -s "$file" ] || return 0
	actual=$(jq -er '.pid | select(type == "number") | tostring' "$file" 2>/dev/null) ||
		return 0
	[ "$actual" = "$pid" ] || return 0
	rm -f "$file"
}

clear_dead_live_records() {
	local file pid
	for file in "$hint_dir/$pane_id.live."*.json; do
		[ -e "$file" ] || continue
		pid=${file##*.live.}
		pid=${pid%.json}
		case "$pid" in ''|*[!0-9]*) continue ;; esac
		if kill -0 "$pid" 2>/dev/null; then
			continue
		fi
		clear_live_record "$pid"
	done
}

# Loads only a completed checkpoint. In particular, a missing or pending
# cursor never falls back to `.session`, an initial --resume, or a latest tip.
load_checkpoint() {
	checkpoint_pid=
	checkpoint_session=
	checkpoint_session_id=
	checkpoint_leaf=
	[ -s "$cursor" ] || return 1
	jq -e '
		.version == 1 and .checkpointed == true
		and (.pid | type == "number" and . > 0)
		and (.sessionFile | type == "string" and length > 0 and startswith("/"))
		and (.sessionId | type == "string" and length > 0)
		and (.leafId | type == "string" and length > 0)
		and (.updatedAt | type == "number" and . > 0)
		and (.runtime.command | type == "array" and length >= 2 and all(.[]; type == "string" and length > 0))
		and (.runtime.command[0] | startswith("/"))
		and (.runtime.env | type == "object" and all(.[]; type == "string"))
	' "$cursor" >/dev/null 2>&1 || return 1
	checkpoint_pid=$(jq -er '.pid | tostring' "$cursor" 2>/dev/null) || return 1
	checkpoint_session=$(jq -er '.sessionFile' "$cursor" 2>/dev/null) || return 1
	checkpoint_session_id=$(jq -er '.sessionId' "$cursor" 2>/dev/null) || return 1
	checkpoint_leaf=$(jq -er '.leafId' "$cursor" 2>/dev/null) || return 1
	[ "$parked" = 1 ] || [ -s "$hint" ] || return 1
	[ -f "$checkpoint_session" ] || return 1
}

safe_hand_back() {
	printf 'omp-pane: sleep checkpoint missing or invalid; returning to shell\n' >&2
	hand_back
}

# Only a reaper request with a completed cursor parks this pane. A deliberate
# quit, crash, or an unconfirmed shutdown must never select another branch.
#
# "Hand the pane back to its shell" was only ever true for a wrapper the reaper
# TYPED into a live prompt: there a shell is our parent and outlives us. The 42
# herdr templates on this machine declare `command = "omp-pane"`, which makes
# the wrapper the pane's DIRECT child — exiting there ends the pane, and a
# one-pane workspace closes with it. That is how 13 panes and 8 workspaces
# disappeared on 2026-09-03 when a revival sweep started wrappers over sessions
# they could not resolve.
#
# So: exit when an interactive login shell is our parent — that lands the user
# back on the prompt they already had. Become the shell otherwise. The test is
# argv[0], not the executable name: a login shell is `-zsh`, and `ps -o comm=`
# strips exactly the dash that carries the answer (all 62 wrappers on this
# machine read `zsh` there and `-zsh` here). herdr's own command panes are a
# separate spawn path that may or may not put `/bin/sh -c` in between, and
# neither shape wears the dash, so both land on the exec.
#
# Guessing wrong is asymmetric, which is why the doubtful case execs: a wrong
# `exit` ends the pane and can close its workspace, a wrong `exec` costs one
# nested shell.
hand_back() {
	# `.session` is the legacy park-vs-exit marker. Cursor and live records
	# belong to this pane, but only dead live PIDs are removed here so a
	# concurrently recreated pane cannot lose a newer snapshot.
	rm -f "$hint" "$frame" "$cursor"
	clear_dead_live_records
	case "$(ps -o command= -p "$PPID" 2>/dev/null)" in
	-*) exit 0 ;;
	esac
	exec "${SHELL:-/bin/sh}" -l
}

run_omp() {
	# Herdr templates preserve the pane/socket variables but do not set this integration gate on
	# a resumed wrapper. Without it OMP never reports its session path, so Collie cannot start voice.
	HERDR_ENV=1 omp "$@"
	[ -s "$hint" ] || hand_back
}

run_omp_resume() {
	local sess=$1 leaf=$2 session_id=$3 value
	local -a runtime_command=() runtime_env=()
	while IFS= read -r -d '' value; do runtime_command+=("$value"); done \
		< <(jq -j '.runtime.command[] | ., "\u0000"' "$cursor")
	while IFS= read -r -d '' value; do runtime_env+=("$value"); done \
		< <(jq -j '.runtime.env | to_entries[] | "\(.key)=\(.value)", "\u0000"' "$cursor")
	env -u PATH -u PI_CONFIG_FILES -u PI_CODING_AGENT_DIR \
		-u PI_CODING_AGENT_SESSION_DIR -u OMP_EXP_LAUNCHER \
		"${runtime_env[@]}" HERDR_ENV=1 OMP_SLEEP_RESUME_SESSION="$session_id" \
		OMP_SLEEP_RESUME_LEAF="$leaf" \
		"${runtime_command[@]}" --resume="$sess" -e "$agent_dir/extensions/sleep-state.ts" \
		/omp-sleep-resume
	[ -s "$hint" ] || hand_back
}

# `--parked`: come up already asleep. The reaper writes a completed cursor
# before this process starts; an argv `--resume` is retained only for old
# callers and is never used as the branch identity.
parked=0
if [ "${1:-}" = --parked ]; then
	parked=1
	shift
fi

[ "$parked" = 1 ] || run_omp "$@"

while :; do
	if ! load_checkpoint; then
		safe_hand_back
	fi
	sess=$checkpoint_session
	leaf=$checkpoint_leaf
	session_id=$checkpoint_session_id

	if [ "$parked" != 1 ]; then
		# Re-exec once per sleep so a wrapper that has been running for days
		# picks up edits to this script instead of carrying a stale body.
		# The cursor stays on disk and is re-read by the new process; never
		# carry the startup `--resume` path across a fork.
		self=$(command -v "$0" 2>/dev/null || true)
		[ -n "$self" ] && exec "$self" --parked
	fi
	parked=0

	badge_sleeping
	omp-frozen "$sess" "$leaf" || { badge_awake; hand_back; }
	badge_awake

	# Waking consumes the legacy park marker, but keeps the completed cursor
	# until a later sleep overwrites it or deliberate close cleans it up.
	rm -f "$hint"
	run_omp_resume "$sess" "$leaf" "$session_id"
done
}
