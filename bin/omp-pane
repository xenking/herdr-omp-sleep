#!/bin/bash
# Whole body is one compound command: bash must read the file to the closing
# brace before it runs anything. Without this, editing this script while a pane
# is parked makes bash resume at a stale byte offset when the pager exits and
# execute the middle of a line as a command — the pane then falls to the shell
# instead of waking omp. (Seen 2026-08-05.)
{
# omp for a herdr pane, with a sleep state.
#
# Runs omp. When omp exits — whether you quit it or the idle reaper sent it a
# SIGTERM — the pane does NOT die: it parks in a frozen, scrollable view of the
# whole conversation. ENTER wakes omp back into the same session.
#
# Measured: less 1.8 MB + this wrapper 2.2 MB, against ~400 MB for a live omp.
# To actually get rid of the pane, close it in herdr as usual.
set -uo pipefail

hint_dir="$HOME/.omp/agent/frozen"
hint="$hint_dir/${HERDR_PANE_ID:-nopane}.session"
# The baked frame doubles as the "this pane is parked" marker the reaper's
# resurrection sweep reads. Every deliberate human exit clears it — `q` in the
# frozen view (omp-frozen, exit 1) and a quit that leaves no hint (below) — so
# what remains means: parked, or a pager that died under it. A herdr restart
# kills the pager without asking, which is exactly the case worth restoring.
frame="$hint_dir/${HERDR_PANE_ID:-nopane}.ans"
mkdir -p "$hint_dir"

# Keep the pane in herdr's agents sidebar while it sleeps, but dimmed.
#
# herdr identifies an agent by the pane's foreground process name, so a pane
# parked in a pager would drop off the list. Worse, while the exited omp
# session still owns the pane, herdr skips detection entirely and the row keeps
# showing a live green `omp`. `pane.report_agent` is the supported way to fix
# both: it is the same socket call omp's own herdr integration uses.
#
# The sequence number is the whole trick. herdr keeps the last seq per
# (pane, source) and silently DROPS anything not greater, while still answering
# `ok` - so an undersized seq looks exactly like a working call that does
# nothing. omp's integration seeds its counter with `Date.now() * 1000`, i.e.
# microseconds since the epoch, so `date +%s` is six orders of magnitude too
# small. One second ahead in microseconds beats everything the dead session
# emitted, and stays behind whatever the next omp process seeds on wake.
badge_label="omp (sleeping)"

seq_bump=0

herdr_req() {
	# The socket path is in every pane's env; fall back to the default so the
	# reaper — which runs from launchd with no pane around it — can reuse this.
	local sock=${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}
	[ -S "$sock" ] && [ -n "${HERDR_PANE_ID:-}" ] || return 0
	# Strictly increasing within this process: park and wake can land in the
	# same second (the pager failing to open takes microseconds), and two
	# calls sharing a second would make the second one a silent no-op.
	seq_bump=$((seq_bump + 1))
	printf '{"id":"omp-pane","method":"pane.%s","params":{"pane_id":"%s","seq":%s%s}}\n' \
		"$1" "$HERDR_PANE_ID" "$(( ($(date +%s) + seq_bump) * 1000000 ))" "$2" |
		nc -U "$sock" >/dev/null 2>&1 || true
}

# Take the pane over from the session that just exited, then claim it as a
# dim `unknown` agent: green idle is reserved for a session that can answer.
badge_sleeping() {
	herdr_req clear_agent_authority ',"source":"herdr:omp"'
	herdr_req report_agent ",\"source\":\"omp-pane\",\"agent\":\"$badge_label\",\"state\":\"unknown\""
}

# Hand the pane back as a live row before omp starts.
#
# This used to be `release_agent`, on the theory that omp's own integration
# would own the row again the moment it started. It does — but only on its next
# state CHANGE, because every painter of that row is edge-triggered: herdr's
# process detection re-reports when the pane's foreground process GROUP changes,
# which under a wrapper it never does. So releasing left the pane with no row at
# all, and a pane that woke straight into a long turn stayed missing from the
# agents sidebar for as long as that turn ran — 10+ minutes on wD:p1D
# (2026-08-17), while the work was visibly happening on screen.
#
# Reporting a live `omp` instead is never wrong for longer than one omp event:
# omp's integration outranks this source and takes the row over, session path
# and all, as soon as it says anything.
badge_awake() {
	herdr_req report_agent ",\"source\":\"omp-pane\",\"agent\":\"omp\",\"state\":\"idle\""
}

# Label a pane from outside it: `--badge` for parked, `--awake` for live.
#
# bash freezes a script's body at exec, so a wrapper that has been running
# since before either label existed can never grow it — and a long-lived wrapper
# never re-execs either. A pane parked by such a wrapper sleeps correctly but
# herdr keeps showing the dead session's green `omp`; a pane woken by one has no
# row at all, because that body still calls `release_agent`. The reaper repairs
# both from here, which keeps the sequence rule above in a single place.
if [ "${1:-}" = --badge ] || [ "${1:-}" = --awake ]; then
	only=$1
	HERDR_PANE_ID=${2:-${HERDR_PANE_ID:-}}
	if [ "$only" = --badge ]; then badge_sleeping; else badge_awake; fi
	exit 0
fi

# Session this pane is on. Never guesses: a wrong resume is worse than no sleep.
resolve_session() {
	local started=$1 hash bucket cand cwd home

	# 1. The reaper read it straight off herdr just before it put us to sleep.
	if [ -s "$hint" ]; then
		cat "$hint"
		return
	fi

	# 2. We were launched against an explicit session.
	for a in "$@"; do
		case $a in
		--resume=*) printf '%s' "${a#--resume=}"; return ;;
		esac
	done

	# 3. A session this pane created after it started. omp 17.2.10+ names the
	#    bucket after the path itself (`-Projects-xdevteam.com-lobby`); older
	#    sessions still carry the retired `<prefix>-<name>-<sha256 of cwd>`
	#    form, so try the hash as a fallback. Birth time — not mtime — so a
	#    sibling pane working in the same directory can never be mistaken for
	#    ours.
	# ponytail: no tmpdir branch — omp's `-tmp-…` form only covers
	# $TMPDIR (/var/folders/… on macOS), which no pane runs in.
	cwd=$(cd "$PWD" && pwd -P)
	home=$(cd "$HOME" && pwd -P)
	case $cwd in
	"$home") bucket="$HOME/.omp/agent/sessions/-" ;;
	"$home"/*) bucket="$HOME/.omp/agent/sessions/-$(printf '%s' "${cwd#"$home"/}" | tr '/:' '--')" ;;
	*) bucket="$HOME/.omp/agent/sessions/--$(printf '%s' "${cwd#/}" | tr '/:' '--')--" ;;
	esac
	if [ ! -d "$bucket" ]; then
		hash=$(printf '%s' "$PWD" | shasum -a256 | cut -d' ' -f1)
		bucket=$(find "$HOME/.omp/agent/sessions" -maxdepth 1 -type d -name "*-$hash" | head -1)
		[ -n "$bucket" ] || return 0
	fi

	cand=$(find "$bucket" -maxdepth 1 -name '*.jsonl' \
		-exec stat -f '%B %N' {} + 2>/dev/null |
		awk -v t="$started" '$1 >= t' | sort -rn | head -1 | cut -d' ' -f2-)
	printf '%s' "$cand"
}

started=$(date +%s)
# Only the reaper parks this pane. It writes the session path into the hint
# file immediately before it signals omp, so a non-empty hint is the one thing
# that means "park". No hint at all is a quit you asked for — Ctrl-C, `/exit`,
# a crash — and an empty hint is the reaper retiring a session with nothing in
# it. Both of those hand the pane back to its shell. Exit codes cannot tell
# them apart: omp leaves on 0 either way.
run_omp() {
	# Herdr templates preserve the pane/socket variables but do not set this integration gate on
	# a resumed wrapper. Without it OMP never reports its session path, so Collie cannot start voice.
	HERDR_ENV=1 omp "$@"
	[ -s "$hint" ] || { rm -f "$hint" "$frame"; exit 0; }
}

# `--parked`: come up already asleep. The reaper uses this to retrofit a sleep
# state onto a pane that was launched as bare `omp` — it kills omp, waits for
# the shell, then starts us here. Everything after the first freeze is the
# ordinary loop, so such a pane is indistinguishable from one wrapped at birth.
parked=0
if [ "${1:-}" = --parked ]; then
	parked=1
	shift
fi

[ "$parked" = 1 ] || run_omp "$@"

while :; do
	sess=$(resolve_session "$started" "$@")
	rm -f "$hint"

	# Could not identify our session — behave like plain omp and hand the pane
	# back to the shell rather than resuming somebody else's conversation.
	[ -n "$sess" ] && [ -f "$sess" ] || exit 0

	if [ "$parked" != 1 ]; then
		# Re-exec once per sleep so a wrapper that has been running for days
		# picks up edits to this script instead of carrying a stale body
		# forever (the brace above makes bash read the whole file at start,
		# which is what keeps a live edit safe — and also what freezes the
		# body for this process). `--parked` lands straight below.
		#
		# $0 is the bare word when herdr spawns us from a template
		# (`command = "omp-pane"`), an absolute path when a shell resolved it:
		# `command -v` covers both, and skipping the exec is harmless.
		self=$(command -v "$0" 2>/dev/null || true)
		[ -n "$self" ] && exec "$self" --parked "--resume=$sess"
	fi
	parked=0

	badge_sleeping
	omp-frozen "$sess" || { badge_awake; exit 0; }
	badge_awake

	started=$(date +%s)
	set -- "--resume=$sess"
	run_omp "$@"
done
}
