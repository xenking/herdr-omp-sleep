#!/bin/bash
# Put idle omp panes to sleep: SIGTERM the agent, leave the pane alive.
#
# Panes launched through `omp-pane` catch the exit and park in a frozen,
# scrollable transcript (~5 MB) instead of dying. ENTER wakes them.
# A pane launched as bare `omp` just drops back to its shell — the session
# .jsonl still survives, so nothing is ever lost either way.
#
# Never touches a pane that is running a turn or waiting on your answer: the
# agent row says so, and a live omp spins a braille marker in the terminal
# title, which is checked too because that row can freeze (see the selector).
#
# Env: IDLE_MIN (default 15) — minutes a conversation must be untouched.
#      EMPTY_MIN (default 4x IDLE_MIN) — omp uptime before a pane whose session
#      has no turns at all is retired to its shell. Also the grace for a pane
#      herdr still calls focused.
#      DRY_RUN=1 to only print.
# Args: --pane <id> — consider only that pane. A bare run sweeps every pane,
#      which is right for the schedule and wrong for a test: verifying one
#      fixture put a real work pane to sleep as a side effect (2026-08-07).
set -euo pipefail

# Default matches EnvironmentVariables.IDLE_MIN in the launchd plist, so a
# manual run shows the same panes the scheduled one acts on.
IDLE_MIN=${IDLE_MIN:-15}
EMPTY_MIN=${EMPTY_MIN:-$((IDLE_MIN * 4))}

ONLY=""
[ "${1:-}" = --pane ] && ONLY=${2:?usage: omp-reap-idle [--pane <id>]}

# The extension and both transport scripts share this state root. The live
# file is per PID; `.session` remains a plain legacy park marker.
AGENT_DIR=${PI_CODING_AGENT_DIR:-$HOME/.omp/agent}
FROZEN_DIR="$AGENT_DIR/frozen"
LIVE_MAX_AGE_MS=15000

# Must match badge_label in omp-pane.
BADGE="omp (sleeping)"
LOG="$HOME/.local/state/omp-reap.log"
mkdir -p "$(dirname "$LOG")"
mkdir -p "$FROZEN_DIR"

# Every conclusion this script draws — which frame is litter, which pane needs
# reviving, which row needs a badge — is about ONE server's pane namespace, the
# default one whose panes own the frames under ~/.omp/agent/frozen. A named
# session (`herdr --session <name>`) has its own disjoint namespace, so its
# answers are not wrong, they are about somebody else: on 2026-09-03 a probe
# server holding a single pane satisfied the prune's "did herdr answer at all"
# check and every one of the 68 real frames on this machine looked like litter.
# Non-emptiness was never the invariant; identity is. Refuse the whole run
# rather than gate one loop, because no loop here survives the wrong server.
default_sock="$HOME/.config/herdr/herdr.sock"
if [ -n "${HERDR_SOCKET_PATH:-}" ] && [ "$HERDR_SOCKET_PATH" != "$default_sock" ]; then
	printf 'refusing: HERDR_SOCKET_PATH=%s is not the default server (%s)\n' \
		"$HERDR_SOCKET_PATH" "$default_sock" >&2
	exit 0
fi

now=$(date +%s)
slept=0
retired=0
badged=0
revived=0

# Who the human is actually looking at. `focused_pane_id` is server-wide: one
# pane holds it, and it follows tab and pane switches. The per-pane `focused`
# flag in `agent list` carries the same value, but reading it per row invites
# treating focus as one signal among many, which is how the pane you were
# reading got slept (see the veto in the loop below).
focused_pane=$(herdr api snapshot 2>/dev/null |
	jq -r '.result.snapshot.focused_pane_id // empty')

# Idle age comes from the last real conversation turn, NOT the file mtime.
# Plenty of things append to a session without you touching it — idle
# compaction (compaction.idleEnabled, fires at idleTimeoutSeconds=300), the
# session_exit record omp writes on shutdown, autolearn. Any of those would
# reset an mtime clock and keep a dead pane awake forever. Measured on a real
# session: mtime said 33 min idle, the last actual turn was 1214 min ago.
# jq does the ISO parsing so this never depends on BSD vs GNU `date`.
idle_minutes() {
	tail -200 "$1" | jq -rs '
		[.[] | select(.type == "message") | .timestamp] | last
		| if . then ((now - (.[0:19] + "Z" | fromdateiso8601)) / 60 | floor) else empty end'
}

# `herdr pane run` TYPES its argv into the pane's tty; it does not spawn. A
# prompt still holding leftover keystrokes therefore concatenates them onto the
# command: one stray character left in wC:p1W turned a revival into
# `zsh: bad pattern: я[200~omp-pane …` and left that pane a bare shell while the
# other 59 came back (2026-09-03). Kill the line first. ctrl+u, not ctrl+c —
# the foreground process here is only known NOT to be omp or a pager, so it can
# be something of the human's that an interrupt would take down.
pane_run_clean() {
	local pane=$1
	shift
	herdr pane send-keys "$pane" ctrl+u >/dev/null 2>&1 || true
	herdr pane run "$pane" "$@" >/dev/null 2>&1
}

# Current title of a session: the last `title_change` if the conversation was
# ever renamed, else the one stamped in the opening `session` record. grep
# first — these files reach tens of megabytes and slurping one through jq to
# read a single field is not worth it.
session_title() {
	local t=
	t=$(grep -a '"type":"title_change"' "$1" 2>/dev/null | tail -1 |
		jq -r '.title // empty' 2>/dev/null) || t=
	[ -n "$t" ] || t=$(head -1 "$1" 2>/dev/null |
		jq -r 'select(.type == "session") | .title // empty' 2>/dev/null) || t=
	printf '%s' "$t"
}

# Minutes -> `5m` / `3h` / `2d`. Minutes because that is the unit every clock in
# this script already speaks (IDLE_MIN, idle_minutes, pid_minutes).
human_minutes() {
	if [ "$1" -lt 60 ]; then
		printf '%sm' "$1"
	elif [ "$1" -lt 1440 ]; then
		printf '%sh' $(($1 / 60))
	else
		printf '%sd' $(($1 / 1440))
	fi
}

# Minutes since a pid started. macOS `ps` has no `etimes`, and the `date` on
# this PATH is GNU-style, so parse ps's own [[dd-]hh:]mm:ss by hand. `+0`
# forces a number: bash arithmetic rejects a zero-padded "08" as octal.
pid_minutes() {
	ps -o etime= -p "$1" 2>/dev/null | awk -F'[-:]' '
		NF == 4 { print $1 * 1440 + $2 * 60 + $3 + 0; next }
		NF == 3 { print $1 * 60 + $2 + 0; next }
		NF == 2 { print $1 + 0 }'
}

valid_pid() {
	case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac
	[ "$1" -gt 0 ] 2>/dev/null
}

clear_live_record() {
	local pane=$1 pid=$2 file actual
	valid_pid "$pid" || return 0
	file="$FROZEN_DIR/$pane.live.$pid.json"
	[ -s "$file" ] || return 0
	actual=$(jq -er '.pid | select(type == "number") | tostring' "$file" 2>/dev/null) ||
		return 0
	[ "$actual" = "$pid" ] || return 0
	rm -f "$file"
}

clear_cursor_record() {
	local pane=$1 pid=${2:-} file actual
	file="$FROZEN_DIR/$pane.cursor.json"
	[ -s "$file" ] || return 0
	if [ -n "$pid" ]; then
		actual=$(jq -er '.pid | select(type == "number") | tostring' "$file" 2>/dev/null) ||
			return 0
		[ "$actual" = "$pid" ] || return 0
	fi
	rm -f "$file"
}

clear_pending_cursor() {
	local pane=$1 pid=$2 file actual
	file="$FROZEN_DIR/$pane.cursor.json"
	[ -s "$file" ] || return 0
	actual=$(jq -er '.pid | select(type == "number") | tostring' "$file" 2>/dev/null) ||
		return 0
	[ "$actual" = "$pid" ] || return 0
	jq -e '.checkpointed == false' "$file" >/dev/null 2>&1 || return 0
	rm -f "$file"
}

# A live snapshot is trusted only when it belongs to the exact omp PID found
# in process-info and was refreshed recently by the root-TUI extension.
load_live_snapshot() {
	local pane=$1 pid=$2 file now_ms
	live_session=
	live_session_id=
	live_leaf=
	valid_pid "$pid" || return 1
	file="$FROZEN_DIR/$pane.live.$pid.json"
	[ -s "$file" ] || return 1
	now_ms=$(( $(date +%s) * 1000 + 999 ))
	jq -e --argjson pid "$pid" --argjson now "$now_ms" --argjson max "$LIVE_MAX_AGE_MS" '
		.version == 1 and .pid == $pid
		and ((.checkpointed // false) == false)
		and (.sessionFile | type == "string" and length > 0 and startswith("/"))
		and (.sessionId | type == "string" and length > 0)
		and ((.leafId == null) or (.leafId | type == "string" and length > 0))
		and ((.updatedAt | type) == "number")
		and (.updatedAt <= $now and ($now - .updatedAt) <= $max)
	' "$file" >/dev/null 2>&1 || return 1
	live_session=$(jq -er '.sessionFile' "$file" 2>/dev/null) || return 1
	live_session_id=$(jq -er '.sessionId' "$file" 2>/dev/null) || return 1
	live_leaf=$(jq -r '.leafId // empty' "$file" 2>/dev/null) || return 1
	[ -f "$live_session" ] || jq -e '.hasMessages == false' "$file" >/dev/null 2>&1
}

# Label/revival paths consume exactly the checkpoint the wrapper will consume.
# No session log or bucket scan is a valid branch fallback.
load_cursor() {
	local pane=$1 file
	cursor_session=
	cursor_session_id=
	cursor_leaf=
	cursor_pid=
	file="$FROZEN_DIR/$pane.cursor.json"
	[ -s "$file" ] || return 1
	jq -e '
		.version == 1 and .checkpointed == true
		and (.pid | type == "number" and . > 0)
		and (.sessionFile | type == "string" and length > 0 and startswith("/"))
		and (.sessionId | type == "string" and length > 0)
		and (.leafId | type == "string" and length > 0)
		and (.updatedAt | type == "number" and . > 0)
	' "$file" >/dev/null 2>&1 || return 1
	cursor_session=$(jq -er '.sessionFile' "$file" 2>/dev/null) || return 1
	cursor_session_id=$(jq -er '.sessionId' "$file" 2>/dev/null) || return 1
	cursor_leaf=$(jq -er '.leafId' "$file" 2>/dev/null) || return 1
	cursor_pid=$(jq -er '.pid | tostring' "$file" 2>/dev/null) || return 1
	[ -f "$cursor_session" ] || return 1
}

write_pending_cursor() {
	local pane=$1 pid=$2 source target tmp
	source="$FROZEN_DIR/$pane.live.$pid.json"
	target="$FROZEN_DIR/$pane.cursor.json"
	tmp="$target.$$"
	jq -c -e --argjson pid "$pid" '
		select(.version == 1 and .pid == $pid)
		| . + {checkpointed: false}
	' "$source" >"$tmp" 2>/dev/null || {
		rm -f "$tmp"
		return 1
	}
	chmod 600 "$tmp" 2>/dev/null || true
	mv -f "$tmp" "$target"
}

while IFS=$'\t' read -r pane sess; do
	[ -n "$pane" ] || continue
	[ -z "$ONLY" ] || [ "$pane" = "$ONLY" ] || continue

	# The pane in front of the human never sleeps. This used to be a soft
	# hint — herdr's per-pane `focused` flag only quadrupled the threshold —
	# because that flag goes stale true: wC:p1 still claimed focus 2.5 h
	# after the last event (2026-08-07). The cost of softening it is worse
	# than the cost of honouring it: a session you were READING, with the
	# tab open in front of you, went to sleep at 75 idle minutes while you
	# looked at it (wD:p1D, 2026-08-17). The snapshot names exactly ONE
	# focused pane for the whole server, so honouring that costs at most one
	# live omp, and it moves the moment you switch panes.
	if [ -n "$focused_pane" ] && [ "$pane" = "$focused_pane" ]; then
		if [ "${DRY_RUN:-0}" = 1 ]; then
			printf 'skip %s focused\n' "$pane"
		else
			printf '%s skip %s focused\n' "$(date +%FT%T)" "$pane" >>"$LOG"
		fi
		continue
	fi

	# An unsent message in the composer. The draft-keeper extension mirrors it
	# here. Text alone could be restored on wake, but a pasted image cannot —
	# omp hands extensions a `[Image #1, …]` marker, never the picture — so a
	# pane that is mid-compose is left awake rather than woken up lossy.
	# Checked first: a pane can hold a draft before it has a session file.
	draft="$FROZEN_DIR/$pane.draft"
	if [ -s "$draft" ]; then
		why="$pane unsent draft ($(stat -f %z "$draft") bytes), left awake"
		if [ "${DRY_RUN:-0}" = 1 ]; then
			printf 'skip %s\n' "$why"
		else
			printf '%s skip %s\n' "$(date +%FT%T)" "$why" >>"$LOG"
		fi
		continue
	fi

pinfo=$(herdr pane process-info --pane "$pane" 2>/dev/null)

# Was this pane launched through the wrapper? If yes it catches the exit
# itself. If no — omp IS the pane's command, and killing it drops the pane
# to its shell; we retrofit the wrapper after the kill below.
wrapped=1
printf '%s' "$pinfo" | jq -e '.result.process_info.foreground_processes[]?
	| select(.cmdline | test("omp-pane"))' >/dev/null 2>&1 || wrapped=0

# Target an exact omp PID and its matching, fresh root-TUI snapshot. The
# command line and herdr's reported session are deliberately ignored:
# either can name a sibling or the pre-fork session.
pid=
sess=
session_id=
leaf=
for candidate_pid in $(printf '%s' "$pinfo" |
	jq -r '.result.process_info.foreground_processes[]?
		| select(.cmdline | test("bin/omp(\\s|$)")) | .pid'); do
	valid_pid "$candidate_pid" || continue
	if load_live_snapshot "$pane" "$candidate_pid"; then
		pid=$candidate_pid
		sess=$live_session
		session_id=$live_session_id
		leaf=$live_leaf
		break
	fi
done
[ -n "$pid" ] || continue

# Is something still WRITING to the session? Idle compaction
# (idleTimeoutSeconds=300) appends without adding a user turn, so the turn
# clock below cannot see it. If the file moved in the last minute, leave
# this pane alone and catch it next tick — never SIGTERM mid-compaction.
if [ -f "$sess" ] && [ $((now - $(stat -f %m "$sess"))) -lt 60 ]; then
	continue
fi

	# A session nobody ever typed into — an omp opened in a pane and left at an
	# empty prompt. Nothing to freeze and nothing to resume, so sleeping it
	# would park the pane on an empty transcript. Retire it instead: omp dies
	# and the wrapper hands the pane back to its shell. The clock is omp's own
	# uptime, since there is no turn to measure from, and
	# the grace is longer than a real conversation gets — a pane sitting at a
	# fresh prompt is plausibly one you are about to type into.
	if ! grep -q '"type":"message"' "$sess" 2>/dev/null; then
		# A session nobody ever typed into has nothing to render. Retire it
		# instead; the empty `.session` tells a wrapped pane to hand back to
		# its shell, while a bare pane gets no stale marker at all.
		age=$(pid_minutes "$pid")
		[ -n "$age" ] && [ "$age" -ge "$EMPTY_MIN" ] || continue
		if [ "${DRY_RUN:-0}" = 1 ]; then
			printf 'would retire %-8s pid=%-7s up=%sm (no turns)\n' \
				"$pane" "$pid" "$age"
			continue
		fi
		clear_cursor_record "$pane"
		clear_live_record "$pane" "$pid"
		rm -f "$FROZEN_DIR/$pane.ans" "$FROZEN_DIR/$pane.session"
		if [ "$wrapped" = 1 ]; then
			: >"$FROZEN_DIR/$pane.session"
		fi
		if ! kill -TERM "$pid" 2>/dev/null; then
			rm -f "$FROZEN_DIR/$pane.session"
			continue
		fi
		clear_live_record "$pane" "$pid"
		printf '%s retired %s pid=%s up=%sm (no turns) %s\n' \
			"$(date +%FT%T)" "$pane" "$pid" "$age" "$sess" >>"$LOG"
		retired=$((retired + 1))
		continue
	fi

	# A real conversation must carry a leaf. A null pre-turn leaf is valid
	# only for the retirement branch above; sleeping it would guess a tip.
	[ -n "$leaf" ] || continue

	age=$(idle_minutes "$sess")
	# No parseable turn in the tail — fall back to the file clock.
	[ -n "$age" ] || age=$(((now - $(stat -f %m "$sess")) / 60))
	# The turn clock measures the CONVERSATION, not the human. Reading a woken
	# pane — paging the session tree, scrolling back — writes no turn, so a
	# session resumed after a night away reads as `idle=1107m` and goes
	# straight back to sleep while you are looking at it (2026-08-12). omp's
	# own uptime is the floor: however old the last turn is, this omp has only
	# been in front of you since it started, so ENTER buys a full IDLE_MIN.
	# ponytail: no screen-diff signal — an idle omp's grid still changes every
	# tick (burn-rate cell), so hashing it would sleep nothing, ever.
	up=$(pid_minutes "$pid")
	if [ -n "$up" ] && [ "$up" -lt "$age" ]; then age=$up; fi
	[ "$age" -ge "$IDLE_MIN" ] || continue

	if [ "${DRY_RUN:-0}" = 1 ]; then
		printf 'would sleep %-8s pid=%-7s idle=%sm\n' "$pane" "$pid" "$age"
		continue
	fi

	# Ask the idle root process to checkpoint before signaling it. A missing
	# shutdown hook must leave the pane awake, never discard its branch.
	if ! write_pending_cursor "$pane" "$pid"; then
		continue
	fi
	printf '%s' "$sess" >"$FROZEN_DIR/$pane.session"
	ready=0
	for attempt in $(seq 1 100); do
		if load_cursor "$pane" && [ "$cursor_pid" = "$pid" ] &&
			load_live_snapshot "$pane" "$pid" &&
			[ "$cursor_session" = "$live_session" ] &&
			[ "$cursor_session_id" = "$live_session_id" ] &&
			[ "$cursor_leaf" = "$live_leaf" ]; then
			ready=1
			break
		fi
		kill -0 "$pid" 2>/dev/null || break
		sleep 0.1
	done
	if [ "$ready" != 1 ]; then
		clear_pending_cursor "$pane" "$pid"
		rm -f "$FROZEN_DIR/$pane.session"
		printf '%s skip %s checkpoint not acknowledged, left awake\n' "$(date +%FT%T)" "$pane" >>"$LOG"
		continue
	fi
	sess=$cursor_session

	# The parked marker. It used to be omp's last frame, baked with `herdr pane
	# read --format ansi` and appended to the frozen view; the native render
	# already ends where the conversation ends, so that only printed the last
	# turn twice and the view stopped showing it (2026-08-16). What is left is
	# the flag the resurrection sweep below keys off — "this pane is parked" —
	# so it is one line, not 150 rows of terminal grid. The `.ans` suffix is
	# kept because live panes on disk already use it.
	printf '%s parked %s\n' "$(date +%FT%T)" "$sess" \
		>"$FROZEN_DIR/$pane.ans"

	# The exact checkpoint is ready; SIGTERM still lets OMP flush and clean up.
	if ! kill -TERM "$pid" 2>/dev/null; then
		clear_pending_cursor "$pane" "$pid"
		if [ -s "$FROZEN_DIR/$pane.session" ] &&
			[ "$(cat "$FROZEN_DIR/$pane.session" 2>/dev/null)" = "$sess" ]; then
			rm -f "$FROZEN_DIR/$pane.session"
		fi
		rm -f "$FROZEN_DIR/$pane.ans"
		continue
	fi
	clear_live_record "$pane" "$pid"
	printf '%s slept %s pid=%s idle=%sm resume=%s\n' \
		"$(date +%FT%T)" "$pane" "$pid" "$age" "$sess" >>"$LOG"
	slept=$((slept + 1))

	[ "$wrapped" = 1 ] && continue

	# Bare pane: park it by hand. `herdr pane run` does not spawn a process —
	# it TYPES the line into the pane's tty. That is only safe once the pane is
	# back at a shell prompt; typed into a live TUI it lands in that program's
	# input (2026-08-05: it became a chat message to an agent). So wait for omp
	# to actually be gone, and bail rather than guess if it lingers.
	for _ in $(seq 20); do
		sleep 0.5
		printf '%s' "$(herdr pane process-info --pane "$pane" 2>/dev/null)" \
			| jq -e '.result.process_info.foreground_processes[]?
				| select(.cmdline | test("bin/omp(\\s|$)"))' >/dev/null 2>&1 || break
	done
	if herdr pane process-info --pane "$pane" 2>/dev/null \
		| jq -e '.result.process_info.foreground_processes[]?
			| select(.cmdline | test("bin/omp(\\s|$)"))' >/dev/null 2>&1; then
		printf '%s WARN %s omp still alive, left at shell\n' \
			"$(date +%FT%T)" "$pane" >>"$LOG"
		continue
	fi
	pane_run_clean "$pane" omp-pane --parked || true
done < <(herdr agent list | jq -r --argjson p "$(herdr pane list)" '
	# `working`/`blocked` in the row is the first-choice "leave it alone", but
	# the row can freeze: a nested session that reports and exits leaves the
	# pane stuck on its last state (wC:p1 sat on `done` for hours while omp
	# ran turns underneath, 2026-08-07). Since the status filter alone can no
	# longer be trusted to notice a live turn, second-guess it with something
	# the pane writes itself — omp puts a braille spinner in the terminal
	# title while a turn is running and `>` when it is waiting for you.
	($p.result.panes // []) as $panes
	| .result.agents[]
	| select(.agent_status == "working" or .agent_status == "blocked" | not)
	| . as $a
	| ($panes[] | select(.pane_id == $a.pane_id) | .terminal_title // "") as $title
	| select($title | test("[\u2800-\u28ff]") | not)
	| "\($a.pane_id)\t\($a.agent_session.value // "")"')

# Two labels this pass repairs from outside, both caused by a wrapper body that
# bash froze at exec (a long-lived wrapper never re-execs, so it can never grow
# a fix):
#
#  - parked but not wearing the badge — the pane sleeps while herdr still shows
#    the dead session's green `omp`. Cannot mislabel a live pane: a running
#    omp's own hook outranks this source, so the badge only shows once omp is
#    gone.
#  - live omp with NO row at all — a pre-2026-08-17 body still releases the
#    pane on wake, and nothing repaints an edge-triggered row until omp's next
#    state change, which a long turn defers indefinitely (wD:p1D).
badger=$(command -v "$(dirname "$0")/omp-pane" 2>/dev/null || command -v omp-pane 2>/dev/null || true)
[ "$slept" = 0 ] || sleep 2 # give a pane just killed a moment to reach its pager
labels=$(herdr agent list | jq -r '.result.agents[]? | "\(.pane_id)\t\(.agent)"')
panes_json=$(herdr pane list)
while read -r pane; do
	[ -n "$pane" ] && [ -n "$badger" ] || continue
	[ -z "$ONLY" ] || [ "$pane" = "$ONLY" ] || continue
	label=$(printf '%s' "$labels" | awk -F'\t' -v p="$pane" '$1 == p { print $2 }')
	case $label in
	"$BADGE") continue ;;
	esac
	pinfo=$(herdr pane process-info --pane "$pane" 2>/dev/null)
	if [ -z "$label" ] && printf '%s' "$pinfo" |
		jq -e '.result.process_info.foreground_processes[]?
			| select(.cmdline | test("bin/omp(\\s|$)"))' >/dev/null 2>&1; then
		if [ "${DRY_RUN:-0}" = 1 ]; then
			printf 'would claim %s (live omp, no row)\n' "$pane"
		else
			"$badger" --awake "$pane"
			printf '%s claimed %s (live omp released by an old wrapper)\n' \
				"$(date +%FT%T)" "$pane" >>"$LOG"
			badged=$((badged + 1))
		fi
		continue
	fi
	printf '%s' "$pinfo" |
		jq -e '.result.process_info.foreground_processes[]?
			| select(.cmdline | test("omp-frozen"))' >/dev/null 2>&1 || continue
	if [ "${DRY_RUN:-0}" = 1 ]; then
		printf 'would badge %s (parked, wrapper too old to label itself)\n' "$pane"
		continue
	fi
	"$badger" --badge "$pane"
	printf '%s badged %s (parked by a pre-badge wrapper)\n' \
		"$(date +%FT%T)" "$pane" >>"$LOG"
	badged=$((badged + 1))
done < <(printf '%s' "$panes_json" | jq -r '.result.panes[]? | .pane_id')

# Make a sleeping row findable. herdr's agents panel orders by space or by
# attention (`ui.agent_panel_sort`) and has no recency order at all, so 55
# parked panes every one of which reads `omp (sleeping)` are a single
# indistinguishable block — there is no way to tell which one holds yesterday's
# work (2026-09-03). `pane report-metadata` is display-only and carries no
# lifecycle authority, so the badge above and the whole sleep machinery stay
# exactly as they are; only what the sidebar prints changes. Re-reported every
# pass, which is what keeps the age honest.
#
# The badge is the gate, NOT the frame file: a frame survives a wake (it is what
# a revival keys off, and omp-frozen only drops it when you close the view on
# purpose), so gating on it labelled every LIVE pane too — a working session
# advertising `0m · <title>` where it should say `omp` (2026-09-03). A pane that
# no longer wears the badge gets its label taken back here, so the display never
# depends on the wake path having fired.
labelled=$(herdr agent list |
	jq -r '.result.agents[]? | select(.display_agent) | .pane_id')
while read -r pane; do
	[ -n "$pane" ] || continue
	[ -z "$ONLY" ] || [ "$pane" = "$ONLY" ] || continue
	label=$(printf '%s' "$labels" | awk -F'\t' -v p="$pane" '$1 == p { print $2 }')
	if [ "$label" != "$BADGE" ]; then
		case " $(printf '%s' "$labelled" | tr '\n' ' ') " in
		*" $pane "*)
			if [ "${DRY_RUN:-0}" = 1 ]; then
				printf 'would unlabel %-8s (awake)\n' "$pane"
			else
				herdr pane report-metadata "$pane" --source omp-pane \
					--clear-display-agent >/dev/null 2>&1 || true
			fi
			;;
		esac
		continue
	fi
	# Display metadata follows the same completed cursor as revival. Frame
	# text and historical logs cannot identify a forked branch.
	load_cursor "$pane" || continue
	sess=$cursor_session
	[ -f "$sess" ] || continue
	title=$(session_title "$sess")
	[ -n "$title" ] || continue
	# The same clock the sleep decision trusts, for the same reason: mtime is
	# bumped by the record omp flushes on SIGTERM, by idle compaction and by
	# autolearn, so a pane whose last real turn was hours ago would advertise
	# itself as minutes old — the exact lie idle_minutes() exists to avoid.
	mins=$(idle_minutes "$sess") || mins=
	[ -n "$mins" ] || mins=$(((now - $(stat -f %m "$sess")) / 60))
	desc="$(human_minutes "$mins") · $title"
	if [ "${DRY_RUN:-0}" = 1 ]; then
		printf 'would label %-8s %s\n' "$pane" "$desc"
		continue
	fi
	herdr pane report-metadata "$pane" --source omp-pane \
		--display-agent "$desc" >/dev/null 2>&1 || true
done < <(printf '%s' "$panes_json" | jq -r '.result.panes[]? | .pane_id')

# A herdr restart restores each pane's layout but not its command line, so every
# parked pane comes back as a bare shell holding nothing, and the session it was
# showing is reachable only through this log (2026-08-13: 32 of 41 panes came up
# this way). Put them back the way they went to sleep — `omp-pane --parked`
# re-opens the frozen view, which costs a pager instead of an omp.
#
# The marker is the baked frame, and it means exactly "parked, or a pager that
# died under it": omp-frozen deletes it when you press `q` (exit 1, never on a
# signal), and the wrapper deletes it when omp quits with no sleep hint —
# `/exit`, Ctrl-C, a crash. So a pane you left on purpose is never restored,
# and a pane whose pager was killed out from under it always is. Frame age is
# NOT a discriminator: a pane parked in place keeps the shell it was launched
# from, which is older than its own frame (wC:p11, 2026-08-15).
#
# Prune first: a frame for a pane herdr no longer lists is litter from a closed
# pane, and 12 of 21 on this machine were exactly that. Unsent drafts are swept
# on the same rule, and they need their own glob: a pane that never slept has a
# draft and no frame, so a frame-only sweep left those behind forever - and a
# reused pane id would then restore a stranger's text into a new composer.
# A pane list that came back empty proves nothing is litter: a server that has
# not restored its workspaces yet, or a named-session server with its own empty
# pane set, would make every frame on this machine look like garbage and delete
# the lot. Zero panes is zero evidence, so the prune is skipped, not trusted.
prunable=1
if [ "$(printf '%s' "$panes_json" | jq -r '(.result.panes | length) // 0' 2>/dev/null || printf 0)" = 0 ]; then
	prunable=0
	[ "${DRY_RUN:-0}" != 1 ] || printf 'skip prune: herdr reported no panes\n'
fi
seen=
for litter in \
	"$FROZEN_DIR"/*.ans "$FROZEN_DIR"/*.draft "$FROZEN_DIR"/*.session \
	"$FROZEN_DIR"/*.cursor.json "$FROZEN_DIR"/*.live.*.json; do
	[ "$prunable" = 1 ] || break
	[ -e "$litter" ] || continue
	base=$(basename "$litter")
	case "$base" in
	*.ans) pane=${base%.ans}; kind=frame ;;
	*.draft) pane=${base%.draft}; kind=draft ;;
	*.session) pane=${base%.session}; kind=session ;;
	*.cursor.json) pane=${base%.cursor.json}; kind=cursor ;;
	*.live.*.json) pane=${base%%.live.*}; kind=live ;;
	*) continue ;;
	esac
	case " $seen " in *" $pane "*) continue ;; esac
	seen="$seen $pane"
	if printf '%s' "$panes_json" |
		jq -e --arg p "$pane" '.result.panes[]? | select(.pane_id == $p)' >/dev/null 2>&1; then
		continue
	fi
	# Do not delete state while any PID that owns a per-PID live record still
	# exists; a delayed pane listing must not erase a live session's checkpoint.
	owner_alive=0
	for live_file in "$FROZEN_DIR/$pane.live."*.json; do
		[ -e "$live_file" ] || continue
		live_pid=${live_file##*.live.}
		live_pid=${live_pid%.json}
		valid_pid "$live_pid" || continue
		if kill -0 "$live_pid" 2>/dev/null; then
			owner_alive=1
		fi
	done
	[ "$owner_alive" = 0 ] || continue
	if [ "${DRY_RUN:-0}" = 1 ]; then
		printf 'would drop stale %s %s\n' "$kind" "$pane"
		continue
	fi
	rm -f "$FROZEN_DIR/$pane.ans" \
		"$FROZEN_DIR/$pane.session" \
		"$FROZEN_DIR/$pane.draft" \
		"$FROZEN_DIR/$pane.cursor.json"
	for live_file in "$FROZEN_DIR/$pane.live."*.json; do
		[ -e "$live_file" ] || continue
		live_pid=${live_file##*.live.}
		live_pid=${live_pid%.json}
		if valid_pid "$live_pid"; then
			clear_live_record "$pane" "$live_pid"
		else
			rm -f "$live_file"
		fi
	done
done

# Rendered views are the bulky part: two files per session per width, 26 MB for
# one 35 MB conversation, 187 MB across this machine's fleet (2026-08-15). A
# view for a width nobody uses any more, or for a session nobody opens, is dead
# weight — and it rebuilds in seconds. Anything untouched for a week goes;
# `less` keeps reading a file it already has open, so this is safe mid-pager.
while IFS= read -r view; do
	[ -n "$view" ] || continue
	if [ "${DRY_RUN:-0}" = 1 ]; then
		printf 'would drop cold view %s\n' "$(basename "$view")"
		continue
	fi
	rm -f "$view"
done < <(find "$FROZEN_DIR" -maxdepth 1 -name '*.ans.txt' -mtime +7 2>/dev/null)
cands=""
while read -r pane; do
	[ -n "$pane" ] || continue
	[ -z "$ONLY" ] || [ "$pane" = "$ONLY" ] || continue
	frame="$FROZEN_DIR/$pane.ans"
	[ -s "$frame" ] || continue
	pinfo=$(herdr pane process-info --pane "$pane" 2>/dev/null) || continue
	# omp, a pager, or the wrapper: the pane is not an orphaned shell.
	printf '%s' "$pinfo" | jq -e '.result.process_info.foreground_processes[]?
		| select(.cmdline | test("omp|less"))' >/dev/null 2>&1 && continue
	spid=$(printf '%s' "$pinfo" | jq -r '.result.process_info.foreground_processes[]?.pid' | head -1)
	[ -n "$spid" ] || continue
	sage=$(pid_minutes "$spid")
	[ -n "$sage" ] || sage=0
	fmtime=$(stat -f %m "$frame" 2>/dev/null) || continue
	fage=$(((now - fmtime) / 60))

	# Use the saved branch checkpoint, never the frame text or the sleep log.
	load_cursor "$pane" || continue
	sess=$cursor_session
	leaf=$cursor_leaf
	[ -f "$sess" ] || continue

	# herdr reuses pane ids. Restoring a cursor from another directory into a
	# recycled pane would hand you somebody else's conversation, so retain the
	# session-bucket ownership guard.
	pcwd=$(printf '%s' "$panes_json" |
		jq -r --arg p "$pane" '.result.panes[]? | select(.pane_id == $p) | .cwd // empty')
	[ -n "$pcwd" ] || continue
	case $pcwd in
	"$HOME") want="-" ;;
	"$HOME"/*) want="-$(printf '%s' "${pcwd#"$HOME"/}" | tr '/:' '--')" ;;
	*) want="--$(printf '%s' "${pcwd#/}" | tr '/:' '--')--" ;;
	esac
	got=$(basename "$(dirname "$sess")")
	if [ "$got" != "$want" ]; then
		[ "$got" = "${got%-*}-$(printf '%s' "$pcwd" | shasum -a256 | cut -d' ' -f1)" ] || continue
	fi

	cands="$cands$pane	$sage	$fage	$sess	$leaf
"
done < <(printf '%s' "$panes_json" | jq -r '.result.panes[]? | .pane_id')

# Two panes may share one session file while pointing at different leaves.
# Keep one revival candidate per pane and let each wrapper consume its own
# cursor; never deduplicate by session path.
while IFS=$'\t' read -r pane sage fage sess leaf; do
	[ -n "$pane" ] || continue
	if [ "${DRY_RUN:-0}" = 1 ]; then
		printf 'would revive %-8s shell=%sm frame=%sm %s\n' "$pane" "$sage" "$fage" "$sess"
		continue
	fi
	pane_run_clean "$pane" omp-pane --parked || continue
	printf '%s revived %s shell=%sm frame=%sm resume=%s leaf=%s\n' \
		"$(date +%FT%T)" "$pane" "$sage" "$fage" "$sess" "$leaf" >>"$LOG"
	revived=$((revived + 1))
done < <(printf '%s' "$cands" | sort -t$'\t' -k1,1 -k3,3n)

[ "${DRY_RUN:-0}" = 1 ] ||
	printf 'slept %s, retired %s, badged %s, revived %s pane(s)\n' \
		"$slept" "$retired" "$badged" "$revived"
