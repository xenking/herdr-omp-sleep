#!/bin/bash
# Put idle omp panes to sleep: SIGTERM the agent, leave the pane alive.
#
# Panes launched through `omp-pane` catch the exit and park in a frozen,
# scrollable transcript (~5 MB) instead of dying. ENTER wakes them.
# A pane launched as bare `omp` just drops back to its shell — the session
# .jsonl still survives, so nothing is ever lost either way.
#
# Never touches a pane that is running a turn or waiting on your answer: the
# agent row says so, and a live omp spins a braille marker in the terminal
# title, which is checked too because that row can freeze (see the selector).
#
# Env: IDLE_MIN (default 15) — minutes a conversation must be untouched.
#      EMPTY_MIN (default 4x IDLE_MIN) — omp uptime before a pane whose session
#      has no turns at all is retired to its shell. Also the grace for a pane
#      herdr still calls focused.
#      DRY_RUN=1 to only print.
# Args: --pane <id> — consider only that pane. A bare run sweeps every pane,
#      which is right for the schedule and wrong for a test: verifying one
#      fixture put a real work pane to sleep as a side effect (2026-08-07).
set -euo pipefail

# Default matches EnvironmentVariables.IDLE_MIN in the launchd plist, so a
# manual run shows the same panes the scheduled one acts on.
IDLE_MIN=${IDLE_MIN:-15}
EMPTY_MIN=${EMPTY_MIN:-$((IDLE_MIN * 4))}

ONLY=""
[ "${1:-}" = --pane ] && ONLY=${2:?usage: omp-reap-idle [--pane <id>]}

# Must match badge_label in omp-pane.
BADGE="omp (sleeping)"
LOG="$HOME/.local/state/omp-reap.log"
mkdir -p "$(dirname "$LOG")"

now=$(date +%s)
slept=0
retired=0
badged=0
revived=0

# Idle age comes from the last real conversation turn, NOT the file mtime.
# Plenty of things append to a session without you touching it — idle
# compaction (compaction.idleEnabled, fires at idleTimeoutSeconds=300), the
# session_exit record omp writes on shutdown, autolearn. Any of those would
# reset an mtime clock and keep a dead pane awake forever. Measured on a real
# session: mtime said 33 min idle, the last actual turn was 1214 min ago.
# jq does the ISO parsing so this never depends on BSD vs GNU `date`.
idle_minutes() {
	tail -200 "$1" | jq -rs '
		[.[] | select(.type == "message") | .timestamp] | last
		| if . then ((now - (.[0:19] + "Z" | fromdateiso8601)) / 60 | floor) else empty end'
}

# Minutes since a pid started. macOS `ps` has no `etimes`, and the `date` on
# this PATH is GNU-style, so parse ps's own [[dd-]hh:]mm:ss by hand. `+0`
# forces a number: bash arithmetic rejects a zero-padded "08" as octal.
pid_minutes() {
	ps -o etime= -p "$1" 2>/dev/null | awk -F'[-:]' '
		NF == 4 { print $1 * 1440 + $2 * 60 + $3 + 0; next }
		NF == 3 { print $1 * 60 + $2 + 0; next }
		NF == 2 { print $1 + 0 }'
}

while IFS=$'\t' read -r pane sess focused; do
	[ -n "$pane" ] || continue
	[ -z "$ONLY" ] || [ "$pane" = "$ONLY" ] || continue

	# An unsent message in the composer. The draft-keeper extension mirrors it
	# here. Text alone could be restored on wake, but a pasted image cannot —
	# omp hands extensions a `[Image #1, …]` marker, never the picture — so a
	# pane that is mid-compose is left awake rather than woken up lossy.
	# Checked first: a pane can hold a draft before it has a session file.
	draft="$HOME/.omp/agent/frozen/$pane.draft"
	if [ -s "$draft" ]; then
		why="$pane unsent draft ($(stat -f %z "$draft") bytes), left awake"
		if [ "${DRY_RUN:-0}" = 1 ]; then
			printf 'skip %s\n' "$why"
		else
			printf '%s skip %s\n' "$(date +%FT%T)" "$why" >>"$LOG"
		fi
		continue
	fi

	pinfo=$(herdr pane process-info --pane "$pane" 2>/dev/null)

	# The session path herdr reports is not proof, and checking that the file
	# exists is not enough to make it proof. Any omp started inside the pane
	# loads the same herdr integration, inherits HERDR_PANE_ID, and reports
	# ITS session as the pane's: a session testing account isolation spawned
	# throwaway agents under `/tmp/acct-iso`, and the row followed each one
	# (2026-08-07). Those files exist, so they read as perfectly good
	# sessions — while the 17 MB conversation the pane is really on goes
	# unmeasured, and sleeping the pane would bake the wrong resume path.
	#
	# The pane's own processes cannot be hijacked that way, so ask them
	# first: the wrapper carries the session it parked on, and an omp
	# resumed by hand carries it on its command line. herdr's answer is the
	# last resort, for a pane on a first-run session nobody has resumed.
	# Whatever the source, a path that resolves to no file is UNKNOWN, and
	# must stay unknown all the way down — the empty-session branch below
	# kills omp, and a real conversation must never look to it like a pane
	# sitting at a fresh prompt.
	for candidate in \
		"$(printf '%s' "$pinfo" | jq -r '[.result.process_info.foreground_processes[]?
			| select(.cmdline | test("omp-pane"))
			| .cmdline | capture("--resume=(?<s>\\S+)").s] | first // empty')" \
		"$(printf '%s' "$pinfo" | jq -r '[.result.process_info.foreground_processes[]?
			| select(.cmdline | test("bin/omp(\\s|$)"))
			| .cmdline | capture("--resume=(?<s>\\S+)").s] | first // empty')" \
		"$sess"; do
		[ -f "$candidate" ] && break
		candidate=""
	done
	sess=$candidate

	# Is something still WRITING to the session? Idle compaction
	# (idleTimeoutSeconds=300) appends without adding a user turn, so the turn
	# clock below cannot see it. If the file moved in the last minute, leave
	# this pane alone and catch it next tick — never SIGTERM mid-compaction.
	if [ -f "$sess" ] && [ $((now - $(stat -f %m "$sess"))) -lt 60 ]; then
		continue
	fi

	# Was this pane launched through the wrapper? If yes it catches the exit
	# itself. If no — omp IS the pane's command, and killing it drops the pane
	# to its shell (herdr logs `agent changed … Some(Omp) -> None`; the shell
	# underneath survives — verified 2026-08-05). We put the wrapper on after
	# the fact, below, so how a pane was started stops mattering.
	wrapped=1
	printf '%s' "$pinfo" | jq -e '.result.process_info.foreground_processes[]?
		| select(.cmdline | test("omp-pane"))' >/dev/null 2>&1 || wrapped=0

	# Target omp itself, never the wrapper that owns the process group —
	# killing the wrapper would take the sleep state down with it. `bin/omp`
	# is anchored so `bin/omp-pane` cannot match. No pgid fallback: if omp
	# cannot be named exactly, skip the pane rather than guess at a pid.
	pid=$(printf '%s' "$pinfo" | jq -r '[.result.process_info.foreground_processes[]?
		| select(.cmdline | test("bin/omp(\\s|$)")) | .pid] | first // empty')
	[ -n "$pid" ] || continue

	# A session nobody ever typed into — an omp opened in a pane and left at an
	# empty prompt. Nothing to freeze and nothing to resume, so sleeping it
	# would park the pane on an empty transcript. Retire it instead: omp dies
	# and the wrapper hands the pane back to its shell. The clock is omp's own
	# uptime, since there is no turn to measure from, and
	# the grace is longer than a real conversation gets — a pane sitting at a
	# fresh prompt is plausibly one you are about to type into.
	if [ -z "$sess" ] || ! grep -q '"type":"message"' "$sess" 2>/dev/null; then
		# No session path at all: too little to act on, leave it alone.
		[ -n "$sess" ] || continue
		age=$(pid_minutes "$pid")
		[ -n "$age" ] && [ "$age" -ge "$EMPTY_MIN" ] || continue
		if [ "${DRY_RUN:-0}" = 1 ]; then
			printf 'would retire %-8s pid=%-7s up=%sm (no turns)\n' \
				"$pane" "$pid" "$age"
			continue
		fi
		# Tell a wrapped pane not to park: an empty hint means "the session
		# you were on is not worth resuming, go back to the shell". Without
		# it the wrapper would fall through to its last resort — the newest
		# session in this directory, which can belong to a different pane
		# working in the same repo. A bare pane has no wrapper to read the
		# hint and would leave it behind to confuse the next wrapper started
		# there, so it gets none.
		if [ "$wrapped" = 1 ]; then
			mkdir -p "$HOME/.omp/agent/frozen"
			: >"$HOME/.omp/agent/frozen/$pane.session"
		fi
		kill -TERM "$pid" 2>/dev/null || continue
		printf '%s retired %s pid=%s up=%sm (no turns) %s\n' \
			"$(date +%FT%T)" "$pane" "$pid" "$age" "$sess" >>"$LOG"
		retired=$((retired + 1))
		continue
	fi

	age=$(idle_minutes "$sess")
	# No parseable turn in the tail — fall back to the file clock.
	[ -n "$age" ] || age=$(((now - $(stat -f %m "$sess")) / 60))
	# The turn clock measures the CONVERSATION, not the human. Reading a woken
	# pane — paging the session tree, scrolling back — writes no turn, so a
	# session resumed after a night away reads as `idle=1107m` and goes
	# straight back to sleep while you are looking at it (2026-08-12). omp's
	# own uptime is the floor: however old the last turn is, this omp has only
	# been in front of you since it started, so ENTER buys a full IDLE_MIN.
	# ponytail: no screen-diff signal — an idle omp's grid still changes every
	# tick (burn-rate cell), so hashing it would sleep nothing, ever.
	up=$(pid_minutes "$pid")
	if [ -n "$up" ] && [ "$up" -lt "$age" ]; then age=$up; fi
	# herdr only learns about focus from its own tab.focus events, so a pane
	# keeps the flag while you work in another window: wC:p1 still claimed
	# focus 2.5 h after the last event (2026-08-07). Honour it, but not
	# forever — a pane you have not typed into for EMPTY_MIN is not one you
	# are looking at, whatever the flag says.
	min=$IDLE_MIN
	[ "$focused" = true ] && min=$EMPTY_MIN
	[ "$age" -ge "$min" ] || continue

	if [ "${DRY_RUN:-0}" = 1 ]; then
		printf 'would sleep %-8s pid=%-7s idle=%sm\n' "$pane" "$pid" "$age"
		continue
	fi

	# Hand the exact session to the omp-pane wrapper. It cannot ask herdr
	# itself once omp is gone — the agent leaves `agent list` with it.
	mkdir -p "$HOME/.omp/agent/frozen"
	printf '%s' "$sess" >"$HOME/.omp/agent/frozen/$pane.session"

	# Bake omp's OWN rendering while it is still alive. herdr already
	# emulated the terminal, so `--format ansi` hands back the finished grid —
	# same colours, same tool-call cards, same layout you were looking at.
	# This is the trick Collie uses to look native without emulating anything
	# (ARCHITECTURE.md §8 / ADR 0008). Only the rows herdr still holds survive;
	# omp is on the alternate screen, so deeper history has to come from the
	# session file instead.
	# A screenful and a half, not a thousand rows: the transcript above the
	# frame is omp's own formatter now, complete, so everything the frame adds
	# beyond the screen you actually left is duplicated text.
	# Rows arrive as a terminal grid: padded with spaces to the full pane width
	# and terminated with CR. Fed to a pager that is exactly as wide, every row
	# wraps by the padding and you get a blank line after every single line.
	# Drop the CR and the trailing pad (keeping any reset that follows it).
	herdr pane read "$pane" --source recent --lines 150 --format ansi 2>/dev/null \
		| tr -d '\r' \
		| sed -E $'s/[[:space:]]+(\033\\[0m)?$/\\1/' \
		>"$HOME/.omp/agent/frozen/$pane.ans" || true

	# SIGTERM, not SIGKILL: omp flushes a final record to the .jsonl on the way
	# out, which is what keeps the session resumable.
	kill -TERM "$pid" 2>/dev/null || continue
	printf '%s slept %s pid=%s idle=%sm resume=%s\n' \
		"$(date +%FT%T)" "$pane" "$pid" "$age" "$sess" >>"$LOG"
	slept=$((slept + 1))

	[ "$wrapped" = 1 ] && continue

	# Bare pane: park it by hand. `herdr pane run` does not spawn a process —
	# it TYPES the line into the pane's tty. That is only safe once the pane is
	# back at a shell prompt; typed into a live TUI it lands in that program's
	# input (2026-08-05: it became a chat message to an agent). So wait for omp
	# to actually be gone, and bail rather than guess if it lingers.
	for _ in $(seq 20); do
		sleep 0.5
		printf '%s' "$(herdr pane process-info --pane "$pane" 2>/dev/null)" \
			| jq -e '.result.process_info.foreground_processes[]?
				| select(.cmdline | test("bin/omp(\\s|$)"))' >/dev/null 2>&1 || break
	done
	if herdr pane process-info --pane "$pane" 2>/dev/null \
		| jq -e '.result.process_info.foreground_processes[]?
			| select(.cmdline | test("bin/omp(\\s|$)"))' >/dev/null 2>&1; then
		printf '%s WARN %s omp still alive, left at shell\n' \
			"$(date +%FT%T)" "$pane" >>"$LOG"
		continue
	fi
	herdr pane run "$pane" omp-pane --parked "--resume=$sess" >/dev/null 2>&1 || true
done < <(herdr agent list | jq -r --argjson p "$(herdr pane list)" '
	# `working`/`blocked` in the row is the first-choice "leave it alone", but
	# the row can freeze: a nested session that reports and exits leaves the
	# pane stuck on its last state (wC:p1 sat on `done` for hours while omp
	# ran turns underneath, 2026-08-07). Since the status filter alone can no
	# longer be trusted to notice a live turn, second-guess it with something
	# the pane writes itself — omp puts a braille spinner in the terminal
	# title while a turn is running and `>` when it is waiting for you.
	($p.result.panes // []) as $panes
	| .result.agents[]
	| select(.agent_status == "working" or .agent_status == "blocked" | not)
	| . as $a
	| ($panes[] | select(.pane_id == $a.pane_id) | .terminal_title // "") as $title
	| select($title | test("[\u2800-\u28ff]") | not)
	| "\($a.pane_id)\t\($a.agent_session.value // "")\t\($a.focused)"')

# Panes that are parked but not wearing the badge: their wrapper body predates
# it (bash froze the body at exec, and a wrapper that never re-execs never
# grows it), so the pane sleeps while herdr still shows the dead session's
# green `omp`. Labelling from here fixes those without touching the running
# wrapper, and cannot mislabel a live pane — a running omp's own herdr hook
# outranks this source, so the badge only becomes visible once omp is gone.
badger=$(command -v "$(dirname "$0")/omp-pane" 2>/dev/null || command -v omp-pane 2>/dev/null || true)
[ "$slept" = 0 ] || sleep 2 # give a pane just killed a moment to reach its pager
labels=$(herdr agent list | jq -r '.result.agents[]? | "\(.pane_id)\t\(.agent)"')
panes_json=$(herdr pane list)
while read -r pane; do
	[ -n "$pane" ] && [ -n "$badger" ] || continue
	[ -z "$ONLY" ] || [ "$pane" = "$ONLY" ] || continue
	case $(printf '%s' "$labels" | awk -F'\t' -v p="$pane" '$1 == p { print $2 }') in
	"$BADGE") continue ;;
	esac
	herdr pane process-info --pane "$pane" 2>/dev/null |
		jq -e '.result.process_info.foreground_processes[]?
			| select(.cmdline | test("omp-frozen"))' >/dev/null 2>&1 || continue
	if [ "${DRY_RUN:-0}" = 1 ]; then
		printf 'would badge %s (parked, wrapper too old to label itself)\n' "$pane"
		continue
	fi
	"$badger" --badge "$pane"
	printf '%s badged %s (parked by a pre-badge wrapper)\n' \
		"$(date +%FT%T)" "$pane" >>"$LOG"
	badged=$((badged + 1))
done < <(printf '%s' "$panes_json" | jq -r '.result.panes[]? | .pane_id')

# A herdr restart restores each pane's layout but not its command line, so every
# parked pane comes back as a bare shell holding nothing, and the session it was
# showing is reachable only through this log (2026-08-13: 32 of 41 panes came up
# this way). Put them back the way they went to sleep — `omp-pane --parked`
# re-opens the frozen view, which costs a pager instead of an omp.
#
# The marker is the baked frame, and it means exactly "parked, or a pager that
# died under it": omp-frozen deletes it when you press `q` (exit 1, never on a
# signal), and the wrapper deletes it when omp quits with no sleep hint —
# `/exit`, Ctrl-C, a crash. So a pane you left on purpose is never restored,
# and a pane whose pager was killed out from under it always is. Frame age is
# NOT a discriminator: a pane parked in place keeps the shell it was launched
# from, which is older than its own frame (wC:p11, 2026-08-15).
#
# Prune first: a frame for a pane herdr no longer lists is litter from a closed
# pane, and 12 of 21 on this machine were exactly that.
for frame in "$HOME/.omp/agent/frozen"/*.ans; do
	[ -e "$frame" ] || continue
	pane=$(basename "$frame" .ans)
	# Explicit ifs, not `test && continue`: bash exempts the left side of a
	# `&&` from `set -e`, but the shape invites the reader to doubt it.
	if printf '%s' "$panes_json" |
		jq -e --arg p "$pane" '.result.panes[]? | select(.pane_id == $p)' >/dev/null 2>&1; then
		continue
	fi
	if [ "${DRY_RUN:-0}" = 1 ]; then
		printf 'would drop stale frame %s\n' "$pane"
		continue
	fi
	rm -f "$frame" "$HOME/.omp/agent/frozen/$pane.session"
done
cands=""
while read -r pane; do
	[ -n "$pane" ] || continue
	[ -z "$ONLY" ] || [ "$pane" = "$ONLY" ] || continue
	frame="$HOME/.omp/agent/frozen/$pane.ans"
	[ -s "$frame" ] || continue
	pinfo=$(herdr pane process-info --pane "$pane" 2>/dev/null) || continue
	# omp, a pager, or the wrapper: the pane is not an orphaned shell.
	printf '%s' "$pinfo" | jq -e '.result.process_info.foreground_processes[]?
		| select(.cmdline | test("omp|less"))' >/dev/null 2>&1 && continue
	spid=$(printf '%s' "$pinfo" | jq -r '.result.process_info.foreground_processes[]?.pid' | head -1)
	[ -n "$spid" ] || continue
	sage=$(pid_minutes "$spid")
	[ -n "$sage" ] || sage=0
	fmtime=$(stat -f %m "$frame" 2>/dev/null) || continue
	fage=$(((now - fmtime) / 60))

	sess=$(grep " slept $pane " "$LOG" 2>/dev/null | tail -1 | sed -E 's/.*resume=//')
	[ -n "$sess" ] || continue
	if [ ! -f "$sess" ]; then
		# omp renames its session buckets between versions; the id is stable.
		sess=$(find "$HOME/.omp/agent/sessions" -maxdepth 2 -name "*_${sess##*_}" 2>/dev/null | head -1)
		[ -n "$sess" ] && [ -f "$sess" ] || continue
	fi

	# herdr reuses pane ids. Restoring a session from another directory into a
	# recycled pane would hand you somebody else's conversation, so the
	# session's bucket has to be the one this cwd resolves to — both of omp's
	# naming forms (see resolve_session in omp-pane).
	pcwd=$(printf '%s' "$panes_json" |
		jq -r --arg p "$pane" '.result.panes[]? | select(.pane_id == $p) | .cwd // empty')
	[ -n "$pcwd" ] || continue
	case $pcwd in
	"$HOME") want="-" ;;
	"$HOME"/*) want="-$(printf '%s' "${pcwd#"$HOME"/}" | tr '/:' '--')" ;;
	*) want="--$(printf '%s' "${pcwd#/}" | tr '/:' '--')--" ;;
	esac
	got=$(basename "$(dirname "$sess")")
	if [ "$got" != "$want" ]; then
		[ "$got" = "${got%-*}-$(printf '%s' "$pcwd" | shasum -a256 | cut -d' ' -f1)" ] || continue
	fi

	cands="$cands$pane	$sage	$fage	$sess
"
done < <(printf '%s' "$panes_json" | jq -r '.result.panes[]? | .pane_id')

# Two panes can name the same session: the reaper resolves a bare pane's
# session by picking the newest file in its bucket, so two panes open on one
# repo can both log the same path (wN:p1 and wN:p3, 2026-08-14). Restoring it
# twice would put two omps on one .jsonl the moment both are woken. The pane
# that slept last — the smallest frame age — owns it; the other stays a shell.
while IFS=$'\t' read -r pane sage fage sess; do
	[ -n "$pane" ] || continue
	if [ "${DRY_RUN:-0}" = 1 ]; then
		printf 'would revive %-8s shell=%sm frame=%sm %s\n' "$pane" "$sage" "$fage" "$sess"
		continue
	fi
	herdr pane run "$pane" omp-pane --parked "--resume=$sess" >/dev/null 2>&1 || continue
	printf '%s revived %s shell=%sm frame=%sm resume=%s\n' \
		"$(date +%FT%T)" "$pane" "$sage" "$fage" "$sess" >>"$LOG"
	revived=$((revived + 1))
done < <(printf '%s' "$cands" | sort -t$'\t' -k4,4 -k3,3n | awk -F'\t' 'NF == 4 && !seen[$4]++')

[ "${DRY_RUN:-0}" = 1 ] ||
	printf 'slept %s, retired %s, badged %s, revived %s pane(s)\n' \
		"$slept" "$retired" "$badged" "$revived"
