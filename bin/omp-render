#!/usr/bin/env bun
// Render a session .jsonl the way omp itself draws it — colours, bubbles,
// tool-call cards, usage footers — by building omp's OWN transcript components
// and asking them for their rows.
//
// omp's TUI components implement `render(width): readonly string[]`
// (pi-tui/src/tui.ts:150). ChatTranscriptBuilder.rebuild(entries) is what the
// TUI itself calls to turn session records into that component tree, so
// container.render(cols) is the real frame — not an imitation of it, and not
// the plain-markdown `/dump` text (that one is `--md` below, useful for
// grepping a conversation but visually nothing like the session).
// Tool output follows omp's own default: folded. `--unfold` expands every tool
// result in full, which is what `o` switches to in the frozen view. `omp
// gallery` — omp's own component-rendering CLI — defaults the same way
// (`args.expanded ?? false`), and this mirrors its width and theme handling too.
//
// Measured: 35 MB / 4605 records / 2871 messages -> 69,445 rows in 2.5s.
//
// Usage: omp-render [--leaf=<leafId>] [--md] [--unfold] <session.jsonl> [width]
import { existsSync } from "node:fs";
import { homedir } from "node:os";

const argv = process.argv.slice(2);
let markdown = false;
let unfold = false;
let leaf: string | undefined;
while (argv.length > 0 && argv[0]?.startsWith("--") === true) {
	const flag = argv.shift()!;
	if (flag === "--md") markdown = true;
	else if (flag === "--unfold") unfold = true;
	else if (flag.startsWith("--leaf=")) {
		leaf = flag.slice("--leaf=".length);
		if (leaf.length === 0) {
			console.error("omp-render: --leaf requires a value");
			process.exit(2);
		}
	} else {
		console.error(`omp-render: unknown flag ${flag}`);
		process.exit(2);
	}
}
const sess: string | undefined = argv[0];
if (sess === undefined || !existsSync(sess)) {
	console.error("usage: omp-render [--leaf=<leafId>] [--md] [--unfold] <session.jsonl> [width]");
	process.exit(2);
}
// Same resolution omp's gallery CLI uses (cli/gallery-cli.ts:181): a requested
// width wins, else the terminal's, else 100 — clamped to what the components
// are known to lay out sanely. process.stdout.columns is undefined whenever
// stdout is a pipe, which is every call from omp-frozen, so the explicit
// argument is the one that matters.
const requested = Number(argv[1] ?? process.env.COLUMNS ?? process.stdout.columns ?? 100);
const width = Math.max(40, Math.min(200, Number.isFinite(requested) ? requested : 100));

// Resolved at run time, not baked: an omp upgrade replaces this tree wholesale.
const src = `${homedir()}/.bun/install/global/node_modules/@oh-my-pi/pi-coding-agent/src`;
if (!existsSync(src)) {
	console.error(`omp-render: omp source tree gone (${src})`);
	process.exit(3);
}

interface Entry {
	id?: string;
	parentId?: string | null;
	type?: string;
	message?: unknown;
}

const entries: Entry[] = [];
for (const line of (await Bun.file(sess).text()).split("\n")) {
	if (line.trim().length === 0) continue;
	try {
		entries.push(JSON.parse(line) as Entry);
	} catch {
		// A session file being appended to can end mid-line; skip it.
	}
}
if (entries.length === 0) {
	console.error("omp-render: no records");
	process.exit(4);
}

const byId = new Map<string, Entry>();
for (const entry of entries) {
	if (entry.id !== undefined) byId.set(entry.id, entry);
}

const treeEntries = entries.filter(entry => entry.id !== undefined && entry.type !== "session");
const walkFrom = (start: Entry): Entry[] => {
	const branch: Entry[] = [];
	const seen = new Set<string>();
	let cursor: Entry | undefined = start;
	while (cursor !== undefined) {
		const id = cursor.id;
		if (id === undefined) {
			console.error("omp-render: ancestry entry is missing an id");
			process.exit(4);
		}
		if (seen.has(id)) {
			console.error(`omp-render: cycle in ancestry at ${id}`);
			process.exit(4);
		}
		seen.add(id);
		branch.push(cursor);
		if (cursor.parentId === undefined || cursor.parentId === null) break;
		const parent = byId.get(cursor.parentId);
		if (parent === undefined) {
			console.error(`omp-render: missing ancestry ${cursor.parentId} for ${id}`);
			process.exit(4);
		}
		cursor = parent;
	}
	branch.reverse();
	return branch;
};

let selected: Entry[];
if (leaf !== undefined) {
	const start = byId.get(leaf);
	if (start === undefined) {
		console.error(`omp-render: leaf not found: ${leaf}`);
		process.exit(4);
	}
	selected = walkFrom(start);
} else if (treeEntries.length === 0) {
	// Legacy files without tree ids have no branch information to disambiguate.
	selected = entries;
} else {
	const childIds = new Set<string>();
	for (const entry of treeEntries) {
		if (entry.parentId !== undefined && entry.parentId !== null) childIds.add(entry.parentId);
	}
	const tips = treeEntries.filter(entry => entry.id !== undefined && !childIds.has(entry.id));
	if (tips.length !== 1) {
		console.error(`omp-render: leaf required (${tips.length === 0 ? "no tip" : "multiple tips"})`);
		process.exit(4);
	}
	selected = walkFrom(tips[0]!);
	if (selected.length !== treeEntries.length) {
		console.error("omp-render: session tree is not an unambiguous single chain");
		process.exit(4);
	}
}

const messageEntries = selected.filter(entry => entry.type === "message" && entry.message !== undefined);

if (markdown) {
	const { formatSessionDumpText } = (await import(`${src}/session/session-dump-format.ts`)) as {
		formatSessionDumpText: (options: { messages: readonly unknown[] }) => string;
	};
	process.stdout.write(formatSessionDumpText({ messages: messageEntries.map(entry => entry.message) }));
	process.exit(0);
}

// Both must run before the components are imported: their constructors read
// settings and the theme at module scope.
const { Settings } = (await import(`${src}/config/settings.ts`)) as {
	Settings: {
		init(options: Record<string, unknown>): Promise<{ get(key: string): unknown }>;
	};
};
const settings = await Settings.init({});
// Exactly the call omp's own gallery CLI makes (cli/gallery-cli.ts:233). A bare
// initTheme() picks up theme.dark/theme.light through getDefaultTheme, but the
// symbol preset and colour-blind mode are separate arguments it never reads —
// so a Nerd-Font setup rendered with ASCII fallbacks until these were passed.
const { initTheme } = (await import(`${src}/modes/theme/theme.ts`)) as {
	initTheme: (
		enableWatcher?: boolean,
		symbolPreset?: unknown,
		colorBlindMode?: unknown,
		darkTheme?: unknown,
		lightTheme?: unknown,
	) => Promise<void>;
};
await initTheme(
	false,
	settings.get("symbolPreset"),
	settings.get("colorBlindMode"),
	settings.get("theme.dark"),
	settings.get("theme.light"),
);

const { ChatTranscriptBuilder } = (await import(`${src}/modes/components/chat-transcript-builder.ts`)) as {
	ChatTranscriptBuilder: new (deps: Record<string, unknown>) => {
		rebuild(entries: readonly unknown[]): void;
		setExpanded(expanded: boolean): void;
		container: { render(width: number): readonly string[] };
		dispose?(): void;
	};
};

// The component tree only ever asks the TUI to schedule a repaint (spinners,
// arriving tool output) and for its image budget. Nothing here is live, so a
// no-op host is the whole contract.
const builder = new ChatTranscriptBuilder({
	ui: {
		requestRender() {},
		requestComponentRender() {},
		resetDisplay() {},
		imageBudget: undefined,
	},
	cwd: process.cwd(),
	requestRender: () => {},
});
builder.setExpanded(unfold);
builder.rebuild(messageEntries as readonly unknown[]);
process.stdout.write(`${builder.container.render(width).join("\n")}\n`);
builder.dispose?.();
process.exit(0);
